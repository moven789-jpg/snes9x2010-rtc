diff --git a/src/spc7110.c b/src/spc7110.c
index 5daef4b..17fa5c9 100644
--- a/src/spc7110.c
+++ b/src/spc7110.c
@@ -306,21 +306,18 @@ static uint32_t spc7110_rtc_mode;
 static uint32_t rtc_state;
 unsigned rtc_index;
 
-/* Emulated-clock RTC tick accumulator.
- *
- * The historic model advanced the RTC by diffing against the host clock
- * (time(0)) on each access. That makes the in-game clock depend on host
- * wall-time: it freezes when no real time passes (fast-forward, netplay,
- * headless, heavy load) and jumps on savestate load -- which is exactly
- * what made Tengai Makyou Zero's "RTC TIME" self-test fail unless real
- * seconds happened to elapse during the check.
- *
- * Instead we tick the RTC from the emulated frame clock: seed the date
- * once from the host clock at load (so the initial date is correct),
- * then advance one emulated second every retro frame-worth of emulated
- * time. This is deterministic, fast-forward-immune, and savestate-safe,
- * matching the behaviour of ares'/bsnes' emulated-clock RTC. */
-static uint32_t spc7110_rtc_subframe;   /* frames accumulated toward 1 s */
+/* Runtime progression stays frame driven. Only the first frame after the
+ * frontend restores battery RAM may apply host elapsed time. The existing
+ * little-endian epoch at bytes 16..19 is refreshed while running.
+ * Default migration mode anchors old files without advancing their date. */
+static uint32_t spc7110_rtc_subframe;
+static bool spc7110_rtc_pending;
+static bool spc7110_rtc_offline;
+
+void S9xSPC7110RTCSetOffline(bool enabled)
+{
+    spc7110_rtc_offline = enabled;
+}
 
 static const unsigned months[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
 
@@ -423,6 +420,73 @@ static void s7_rtc_advance(unsigned seconds)
 	s7_rtc_advance_raw(seconds);
 }
 
+/* Validate before applying elapsed time: never turn an uninitialized battery
+ * image into an unsigned day/month underflow. Leave invalid registers intact. */
+static bool s7_rtc_valid(void)
+{
+    unsigned i, day, month, year, limit;
+    for (i = 0; i < 12; i++)
+        if (RTCData.reg[i] > 9) return false;
+    if (RTCData.reg[0] + RTCData.reg[1]*10 > 59 ||
+        RTCData.reg[2] + RTCData.reg[3]*10 > 59 ||
+        RTCData.reg[4] + RTCData.reg[5]*10 > 23 ||
+        RTCData.reg[12] > 6) return false;
+    month = RTCData.reg[8] + RTCData.reg[9]*10;
+    day = RTCData.reg[6] + RTCData.reg[7]*10;
+    year = RTCData.reg[10] + RTCData.reg[11]*10;
+    year += year >= 90 ? 1900 : 2000;
+    if (month < 1 || month > 12) return false;
+    limit = months[month-1];
+    if (month == 2 && year % 4 == 0 &&
+        (year % 100 != 0 || year % 400 == 0)) limit++;
+    return day >= 1 && day <= limit;
+}
+
+/* A failed host clock read leaves the prior anchor untouched. The legacy
+ * format only has an unsigned 32-bit epoch (through February 2106). */
+static bool s7_rtc_host(uint32_t *now)
+{
+    time_t t = time(NULL);
+    if (t <= 0 || (uint64_t)t > UINT32_MAX) return false;
+    *now = (uint32_t)t;
+    return true;
+}
+
+static void s7_rtc_stamp(uint32_t now)
+{
+    unsigned i;
+    for (i = 0; i < 4; i++) RTCData.reg[16+i] = (uint8_t)(now >> (i*8));
+}
+
+/* Savestate restores keep the date supplied by that state, but rebase its
+ * host anchor. Thus an old state's timestamp is never counted as downtime. */
+void S9xSPC7110RTCRebase(void)
+{
+    uint32_t now;
+    if (!Settings.SPC7110RTC) return;
+    spc7110_rtc_pending = false;
+    if (s7_rtc_host(&now)) s7_rtc_stamp(now);
+}
+
+static void s7_rtc_resume(void)
+{
+    uint32_t now, then;
+    if (!s7_rtc_host(&now)) return;
+    then = (uint32_t)RTCData.reg[16] |
+           (uint32_t)RTCData.reg[17] << 8 |
+           (uint32_t)RTCData.reg[18] << 16 |
+           (uint32_t)RTCData.reg[19] << 24;
+    if (spc7110_rtc_pending) {
+        spc7110_rtc_pending = false;
+        /* Backwards clock changes and implausible >68-year deltas reanchor.
+         * Forward clock changes are indistinguishable from real downtime. */
+        if (spc7110_rtc_offline && then != 0 && now >= then &&
+            now - then <= INT32_MAX && s7_rtc_valid())
+            s7_rtc_advance(now - then);
+    }
+    s7_rtc_stamp(now);
+}
+
 /* Per-frame tick, called once per emulated frame from the CPU frame
  * boundary. Accumulates frames and advances the RTC one second per
  * emulated second (60 fps NTSC / 50 fps PAL). */
@@ -433,12 +497,15 @@ void S9xSPC7110RTCTick (void)
 	if(!Settings.SPC7110RTC)
 		return;
 
+	s7_rtc_resume();
+
 	frames_per_second = Settings.PAL ? 50 : 60;
 
 	if(++spc7110_rtc_subframe >= frames_per_second)
 	{
 		spc7110_rtc_subframe = 0;
-		s7_rtc_advance(1);
+		if (s7_rtc_valid())
+			s7_rtc_advance(1);
 	}
 }
 
@@ -2067,6 +2134,7 @@ void S9xInitSPC7110 (void)
 	memset(RTCData.reg, 0, 20);
 	if(Settings.SPC7110RTC)
 		s7_rtc_seed_from_host();
+	spc7110_rtc_pending = true;
 }
 
 void S9xResetSPC7110 (void)
