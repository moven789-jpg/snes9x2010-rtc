diff --git a/.github/workflows/switch-rtc.yml b/.github/workflows/switch-rtc.yml
new file mode 100644
index 0000000..c2b0855
--- /dev/null
+++ b/.github/workflows/switch-rtc.yml
@@ -0,0 +1,44 @@
+name: Switch SPC7110 RTC build
+on:
+  workflow_dispatch:
+  push:
+    paths:
+      - 'src/**'
+      - 'libretro/**'
+      - 'tests/**'
+      - 'tools/build_switch_rtc.sh'
+      - '.github/workflows/switch-rtc.yml'
+permissions:
+  contents: read
+jobs:
+  rtc-tests:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+      - name: RTC regression tests (ASan and UBSan)
+        run: bash tests/run_rtc_tests.sh
+      - name: Host core build
+        run: make -f Makefile.libretro -j2
+  switch:
+    needs: rtc-tests
+    runs-on: ubuntu-24.04
+    container: devkitpro/devkita64:latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v4
+      - name: Update official SDK and dependencies
+        shell: bash
+        run: |
+          set -euo pipefail
+          pacman -Syu --noconfirm
+          pacman -S --needed --noconfirm devkit-env devkitA64 libnx switch-tools switch-mesa switch-zlib switch-bzip2 switch-liblzma switch-libpng switch-libvpx switch-ffmpeg switch-libopus git make
+      - name: Build static core and linked RetroArch NRO
+        shell: bash
+        run: bash tools/build_switch_rtc.sh
+      - name: Downloadable build files
+        uses: actions/upload-artifact@v4
+        with:
+          name: snes9x2010-switch-rtc
+          path: rtc-dist/
+          if-no-files-found: error
+          retention-days: 30
