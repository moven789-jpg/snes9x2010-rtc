@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+bin=$(mktemp)
+trap 'rm -f "$bin"' EXIT
+${CC:-cc} -std=gnu11 -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer \
+ -ffunction-sections -fdata-sections -D__LIBRETRO__ \
+ -Ilibretro -Isrc -Ilibretro/libretro-common/include \
+ tests/test_offline_rtc.c -Wl,--gc-sections -o "$bin"
+ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}" "$bin"
diff --git a/tests/test_offline_rtc.c b/tests/test_offline_rtc.c
new file mode 100644
index 0000000..ce8d926
--- /dev/null
+++ b/tests/test_offline_rtc.c
@@ -0,0 +1,55 @@
+/* Compile the production translation unit with a deterministic host clock.
+ * Linker garbage collection removes unrelated emulator entry points. */
+#include <assert.h>
+#include <stdio.h>
+#include <time.h>
+static time_t fake_now;
+static time_t test_time(time_t *out) { if (out) *out=fake_now; return fake_now; }
+#define time test_time
+#include "../src/spc7110.c"
+#undef time
+struct SSettings Settings;
+struct SRTCData RTCData;
+static int field(int n) { return RTCData.reg[n]+10*RTCData.reg[n+1]; }
+static void set_date(int y,int m,int d,int h,int min,int sec) {
+ int a[6]={sec,min,h,d,m,y},i;
+ memset(RTCData.reg,0,20);
+ for(i=0;i<6;i++){RTCData.reg[i*2]=a[i]%10;RTCData.reg[i*2+1]=a[i]/10;}
+ RTCData.reg[12]=5; Settings.SPC7110RTC=true;Settings.PAL=false;
+ spc7110_rtc_subframe=0;spc7110_rtc_pending=true;
+ fake_now=1792300000; s7_rtc_stamp((uint32_t)fake_now);
+ S9xSPC7110RTCSetOffline(true);
+}
+static void expect(int y,int m,int d,int h,int min,int sec) {
+ assert(field(10)==y);assert(field(8)==m);assert(field(6)==d);
+ assert(field(4)==h);assert(field(2)==min);assert(field(0)==sec);
+}
+int main(void) {
+ uint8_t saved[20]; int i;
+ set_date(96,10,18,15,0,0);memcpy(saved,RTCData.reg,20);
+ fake_now+=40*3600;S9xSPC7110RTCTick();expect(96,10,20,7,0,0);
+ S9xSPC7110RTCTick();expect(96,10,20,7,0,0); /* no duplicate catch-up */
+ set_date(96,2,28,23,59,59);fake_now++;s7_rtc_resume();expect(96,2,29,0,0,0);
+ set_date(97,2,28,23,59,59);fake_now++;s7_rtc_resume();expect(97,3,1,0,0,0);
+ set_date(99,12,31,23,59,59);fake_now++;s7_rtc_resume();expect(0,1,1,0,0,0);
+ set_date(0,2,28,23,59,59);fake_now++;s7_rtc_resume();expect(0,2,29,0,0,0);
+ set_date(96,10,18,15,0,0);fake_now-=100;s7_rtc_resume();expect(96,10,18,15,0,0);
+ set_date(96,10,18,15,0,0);S9xSPC7110RTCSetOffline(false);
+ fake_now+=30*365*86400;s7_rtc_resume();expect(96,10,18,15,0,0); /* migration */
+ set_date(96,10,18,15,0,0);fake_now+=40*3600;S9xSPC7110RTCRebase();
+ s7_rtc_resume();expect(96,10,18,15,0,0); /* savestate date preserved */
+ set_date(96,10,18,15,0,0);RTCData.reg[13]=1;fake_now+=3600;
+ s7_rtc_resume();expect(96,10,18,15,0,0); /* hardware stop flag */
+ set_date(96,10,18,15,0,0);fake_now=-1;s7_rtc_resume();
+ assert(spc7110_rtc_pending);expect(96,10,18,15,0,0);
+ set_date(96,10,18,15,0,0);RTCData.reg[8]=0;RTCData.reg[9]=0;
+ fake_now+=3600;s7_rtc_resume();assert(field(8)==0); /* don't repair corrupt input */
+ set_date(96,10,18,15,0,0);spc7110_rtc_pending=false;
+ for(i=0;i<60;i++) S9xSPC7110RTCTick();expect(96,10,18,15,0,1);
+ set_date(96,10,18,15,0,0);Settings.PAL=true;
+ for(i=0;i<50;i++) S9xSPC7110RTCTick();expect(96,10,18,15,0,1);
+ set_date(96,10,18,15,0,0);memcpy(RTCData.reg,saved,20);
+ fake_now+=144000;s7_rtc_resume();expect(96,10,20,7,0,0); /* raw 20-byte reload */
+ puts("PASS: 40h, one-shot, leap/month/year, backward clock, migration, state rebase, stop, invalid clock/date, NTSC/PAL, 20-byte reload");
+ return 0;
+}
diff --git a/tools/build_switch_rtc.sh b/tools/build_switch_rtc.sh
new file mode 100755
index 0000000..0525afe
--- /dev/null
+++ b/tools/build_switch_rtc.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+core_root=$PWD
+: "${DEVKITPRO:=/opt/devkitpro}"
+export DEVKITPRO
+export DEVKITA64="$DEVKITPRO/devkitA64"
+export PATH="$DEVKITA64/bin:$DEVKITPRO/tools/bin:$PATH"
+test -f "$DEVKITPRO/libnx/switch_rules"
+command -v aarch64-none-elf-gcc
+# Use a clean disposable checkout; host objects must never enter this build.
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+mkdir "$work/core"
+tar --exclude=.git --exclude='*.o' --exclude='*.so' --exclude='*.a' \
+ --exclude=rtc-dist --exclude=retroarch-build -cf - . | tar -xf - -C "$work/core"
+make -C "$work/core" -f Makefile.libretro platform=libnx -j2
+mkdir -p "$core_root/rtc-dist"
+cp "$work/core/snes9x2010_libretro_libnx.a" "$core_root/rtc-dist/"
+# Source pin verified when this patch was prepared; SDK/container are rolling.
+ra_commit=054601aa638a0730826d7d8a3b5926c7f9e42219
+git init "$work/retroarch"
+git -C "$work/retroarch" remote add origin https://github.com/libretro/RetroArch.git
+git -C "$work/retroarch" fetch --depth 1 origin "$ra_commit"
+git -C "$work/retroarch" checkout --detach FETCH_HEAD
+cp "$core_root/rtc-dist/snes9x2010_libretro_libnx.a" "$work/retroarch/libretro_libnx.a"
+make -C "$work/retroarch" -f Makefile.libnx -j2
+# Verify NRO0 magic at offset 0x10; never upload an archive renamed to NRO.
+test "$(dd if="$work/retroarch/retroarch_switch.nro" bs=1 skip=16 count=4 status=none)" = NRO0
+cp "$work/retroarch/retroarch_switch.nro" "$core_root/rtc-dist/snes9x2010_rtc_libretro_libnx.nro"
+{
+ printf 'RetroArch commit: %s\n' "$ra_commit"
+ aarch64-none-elf-gcc --version
+ "$(command -v dkp-pacman || command -v pacman)" -Q devkitA64 libnx switch-tools switch-mesa switch-ffmpeg
+} > "$core_root/rtc-dist/BUILD-INFO.txt"
+cd "$core_root/rtc-dist"
+sha256sum ./*.a ./*.nro BUILD-INFO.txt > SHA256SUMS.txt
